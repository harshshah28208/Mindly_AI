# ==============================================================================
# MINDLY CONFIGURATION — MULTIMODAL MENTAL-WELLNESS & STUDY COMPANION
# ==============================================================================

# LLM Provider: "auto" (default: try cloud then local ollama), "ollama" (local only), "groq", or "openai"
LLM_PROVIDER=auto

# Graceful Heuristic Fallback: "true" (gracefully degrade to local rule-synthesis on model failure) or "false" (show diagnostic error)
LLM_FALLBACK_ENABLED=true

# Cloud Provider API Keys (Optional - enables instant high-speed dynamic responses)
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Primary Local Ollama Model
OLLAMA_MODEL=llama3.2:1b

# Secondary Coping Model
COPING_MODEL=llama3.2:1b

# Embedding Model (defaults to OLLAMA_MODEL)
EMBEDDING_MODEL=llama3.2:1b

# Vision Model (e.g. "llava", "llama3.2-vision")
VISION_MODEL=llava

# Ollama Base URL & Generation Hyperparameters
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.7

# Configurable Output Token Budgets (Phase 8: 100-200 greetings, 300-512 normal, 700-1024 detailed)
OLLAMA_MAX_TOKENS=512
TOKEN_BUDGET_GREETINGS=150
TOKEN_BUDGET_NORMAL=512
TOKEN_BUDGET_DETAILED=1024

# Agentic Evaluator Bounds
MAX_EVAL_RETRIES=2

# Knowledge & RAG Configuration
KNOWLEDGE_DIR=data/knowledge
VECTOR_DB_DIR=data/vectorstore
GALE_PDF_FILENAME=gale_encyclopedia.pdf

# Persistent Database (Memory, Journal, Goals)
DB_PATH=data/app.db
DATABASE_PATH=data/app.db

# Voice Processing
STT_PROVIDER=local
WHISPER_MODEL=small
TTS_PROVIDER=local

# Human Supervisor Escalation ("demo" or "production")
ESCALATION_MODE=demo
SUPERVISOR_NAME=Project Owner
SUPERVISOR_PHONE=+1-555-0199

# App Title & Name
APP_TITLE=Mindly - Multimodal Mental-Wellness Companion
APP_NAME=Mindly

